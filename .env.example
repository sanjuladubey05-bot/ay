# APP_URL: The public origin where this application is hosted (used for strict CORS allowlisting).
APP_URL="http://localhost:3000"

# SUPABASE POSTGRESQL CONFIGURATION (Server-side only)
# Never expose SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, or secrets to browser bundles.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# RAZORPAY PAYMENT GATEWAY CONFIGURATION (Server-side only)
# Default to test mode until merchant KYC, live credentials, and webhooks are verified.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MODE=test

# INITIAL OWNER ADMIN CONFIGURATION
# Optional: if ADMIN_BOOTSTRAP_PASSWORD is unset, use the one-time /admin/login claim flow.
OWNER_ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# SESSION & STORAGE CONFIGURATION
SESSION_SECRET=
LPS_MEDIA_UPLOAD_DIR=

